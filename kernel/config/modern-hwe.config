# Reviewed delta layered on top of /boot/config-$(uname -r).
# merge_config.sh ignores symbols that do not exist in the pinned source; review
# build/kernel-7.0.14/config-delta.txt and the merge warnings before deployment.

# Preserve Ubuntu/DKMS behavior without forcing signatures in the non-Secure-Boot build.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_MODULE_SIG=y
# CONFIG_MODULE_SIG_FORCE is not set
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_NONE=y

# CPU, power, platform and virtualization
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_CPU_IDLE=y
CONFIG_INTEL_IDLE=y
CONFIG_ACPI=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_THERMAL=y
CONFIG_THERMAL=y
CONFIG_INTEL_PMC_CORE=m
CONFIG_INTEL_VSEC=m
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
CONFIG_HWMON=y
CONFIG_PLATFORM_PROFILE=y
CONFIG_ASUS_WMI=m
CONFIG_ASUS_NB_WMI=m
CONFIG_ASUS_ARMOURY=m

# Graphics and display connectivity. Keep i915 for fallback/older Intel IDs.
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_DP_AUX_CHARDEV=y
CONFIG_DRM_DP_CEC=y
CONFIG_TYPEC=m
CONFIG_TYPEC_DP_ALTMODE=m
CONFIG_TYPEC_UCSI=m
CONFIG_UCSI_ACPI=m

# Storage, PCIe, USB4 and Thunderbolt
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_NVME_CORE=m
CONFIG_BLK_DEV_NVME=m
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=m
CONFIG_USB4=m
CONFIG_THUNDERBOLT=m

# Intel wireless/Bluetooth and common laptop input/media paths
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_BT=m
CONFIG_BT_INTEL=m
CONFIG_BTUSB=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_SOC_SOF=m
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=m
CONFIG_HID_MULTITOUCH=m
CONFIG_I2C_HID_ACPI=m

# Containers expected by Jammy development/robotics workloads
CONFIG_NAMESPACES=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_OVERLAY_FS=m
CONFIG_VETH=m
CONFIG_BRIDGE=m
